<%- include('partials/head') %>
<% if (uploaded) { %><div class="alert ok" role="status">Uploaded <%= uploaded %>. Copy the path below into an image field.</div><% } %>

<div class="card">
  <div class="card-head"><h2>Upload an image</h2></div>
  <% if (can('media:write')) { %>
  <form method="post" action="/admin/media" enctype="multipart/form-data" class="form-row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="file">Image file</label>
      <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" required>
      <span class="hint">JPEG, PNG, WebP or AVIF · up to 5 MB.</span>
    </div>
    <div class="field">
      <label for="alt">Alt text</label>
      <input id="alt" name="alt" maxlength="300" placeholder="Describe the image for screen readers">
      <span class="hint">Required for accessibility reporting to stay green.</span>
    </div>
    <div class="field" style="align-self:end"><button class="btn" type="submit">Upload</button></div>
  </form>
  <% } else { %><p class="muted">Your role cannot upload media.</p><% } %>
</div>

<div class="card">
  <div class="card-head"><h2>Library</h2><span class="small muted"><%= media.length %> file<%= media.length === 1 ? '' : 's' %></span></div>
  <% if (!media.length) { %><p class="muted">No media uploaded yet. Site imagery in /assets is version-controlled with the design system.</p><% } %>
  <div class="media-grid">
    <% media.forEach(function (file) { %>
    <div class="media-card">
      <img src="/uploads/<%= file.filename %>" alt="<%= file.alt || '' %>" loading="lazy">
      <div class="media-meta">
        <strong><%= file.filename %></strong>
        <div class="muted"><%= Math.round(file.size / 1024) %> KB · <%= formatDate(file.created_at, { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
        <button class="btn secondary small" type="button" data-copy="/uploads/<%= file.filename %>" style="margin-top:6px">Copy path</button>
      </div>
      <form method="post" action="/admin/media/<%= file.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="sr-only" for="alt-<%= file.id %>">Alt text</label>
        <input id="alt-<%= file.id %>" name="alt" value="<%= file.alt || '' %>" maxlength="300" placeholder="Alt text">
        <label class="sr-only" for="caption-<%= file.id %>">Caption</label>
        <input id="caption-<%= file.id %>" name="caption" value="<%= file.caption || '' %>" maxlength="300" placeholder="Caption" style="margin-top:6px">
        <div class="btn-row" style="margin-top:8px">
          <button class="btn secondary small" type="submit">Save</button>
        </div>
      </form>
      <form method="post" action="/admin/media/<%= file.id %>/delete" data-confirm="Delete this file?" style="padding:0 12px 12px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn danger small" type="submit">Delete</button>
      </form>
    </div>
    <% }); %>
  </div>
</div>
<%- include('partials/foot') %>
