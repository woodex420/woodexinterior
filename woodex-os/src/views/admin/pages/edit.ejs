<%- include('../partials/head') %>
<%
  var isNew = !page;
  var action = isNew ? '/admin/pages' : '/admin/pages/' + page.id;
  var v = values || {};
%>
<form method="post" action="<%= action %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="split">
    <div>
      <div class="card">
        <div class="card-head"><h2>Page</h2><a class="btn secondary small" href="/admin/pages">Back to list</a></div>
        <div class="field">
          <label for="title">Title</label>
          <input id="title" name="title" required maxlength="200" value="<%= v.title || '' %>"<%- errors.title ? ' aria-invalid="true"' : '' %>>
          <% if (errors.title) { %><span class="field-error"><%= errors.title %></span><% } %>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="slug">URL slug</label>
            <input id="slug" name="slug" maxlength="120" value="<%= v.slug || '' %>" placeholder="about"<%- errors.slug ? ' aria-invalid="true"' : '' %>>
            <span class="hint">Lowercase words separated by hyphens. Leave blank to generate from the title.</span>
            <% if (errors.slug) { %><span class="field-error"><%= errors.slug %></span><% } %>
          </div>
          <div class="field">
            <label for="template">Template</label>
            <select id="template" name="template">
              <% ['default','home','contact','style-guide','404'].forEach(function (option) { %>
              <option value="<%= option %>"<%- (v.template || 'default') === option ? ' selected' : '' %>><%= option %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="form-row three">
          <div class="field">
            <label for="page_type">Page type</label>
            <select id="page_type" name="page_type">
              <% ['page','home','legal','system'].forEach(function (option) { %>
              <option value="<%= option %>"<%- (v.page_type || 'page') === option ? ' selected' : '' %>><%= option %></option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="draft"<%- (v.status || 'draft') === 'draft' ? ' selected' : '' %>>Draft</option>
              <option value="published"<%- v.status === 'published' ? ' selected' : '' %>>Published</option>
            </select>
          </div>
          <div class="field">
            <label for="sort_order">Menu order</label>
            <input id="sort_order" name="sort_order" type="number" value="<%= v.sort_order || 0 %>">
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h2>Page blocks</h2><span class="small muted">Blocks render in this order</span></div>
        <script type="application/json" id="block-schema"><%- JSON.stringify(blockSchema) %></script>
        <script type="application/json" id="blocks-data"><%- JSON.stringify(v.blocks || []) %></script>
        <div id="blocks-editor"></div>
        <noscript><p class="alert warn">JavaScript is disabled: edit the raw block JSON instead.</p>
          <textarea name="blocks" class="mono" rows="16"><%= JSON.stringify(v.blocks || [], null, 2) %></textarea>
        </noscript>
      </div>

      <div class="card">
        <div class="card-head"><h2>Search engine optimisation</h2></div>
        <div class="field">
          <label for="seo_title">SEO title</label>
          <input id="seo_title" name="seo_title" maxlength="70" value="<%= v.seo_title || '' %>"<%- errors.seo_title ? ' aria-invalid="true"' : '' %>>
          <span class="hint">Aim for 50–60 characters. Falls back to the page title.</span>
          <% if (errors.seo_title) { %><span class="field-error"><%= errors.seo_title %></span><% } %>
        </div>
        <div class="field">
          <label for="seo_description">Meta description</label>
          <textarea id="seo_description" name="seo_description" maxlength="320" rows="3"<%- errors.seo_description ? ' aria-invalid="true"' : '' %>><%= v.seo_description || '' %></textarea>
          <span class="hint">140–160 characters. Every page should be unique.</span>
          <% if (errors.seo_description) { %><span class="field-error"><%= errors.seo_description %></span><% } %>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="og_image">Social share image</label>
            <input id="og_image" name="og_image" maxlength="500" value="<%= v.og_image || '' %>" placeholder="/assets/detail.jpg" list="media-options">
            <span class="hint">Path such as /assets/detail.jpg or /uploads/file.jpg</span>
          </div>
          <div class="field">
            <label for="canonical">Canonical URL override</label>
            <input id="canonical" name="canonical" maxlength="500" value="<%= v.canonical || '' %>" placeholder="Leave blank to use the live URL">
          </div>
        </div>
        <label class="check"><input type="checkbox" name="noindex" value="1"<%- v.noindex ? ' checked' : '' %>> Hide from search engines (noindex)</label>
      </div>
    </div>

    <aside>
      <div class="card">
        <div class="card-head"><h2>Publish</h2></div>
        <p class="small muted">Status: <span class="badge <%= (v.status || 'draft') %>"><%= v.status || 'draft' %></span></p>
        <div class="btn-row">
          <button class="btn" type="submit">Save page</button>
          <% if (!isNew) { %><a class="btn secondary" href="/preview/<%= page.slug %>" target="_blank" rel="noopener">Preview</a><% } %>
        </div>
        <% if (!isNew) { %>
        <p class="small muted" style="margin-top:12px">Last saved <%= formatDate(page.updated_at, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        <% } %>
      </div>

      <% if (!isNew) { %>
      <div class="card">
        <div class="card-head"><h2>Status</h2></div>
        <form method="post" action="/admin/pages/<%= page.id %>/publish">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn secondary" type="submit" style="width:100%"><%= page.status === 'published' ? 'Unpublish (move to draft)' : 'Publish this page' %></button>
        </form>
        <form method="post" action="/admin/pages/<%= page.id %>/delete" data-confirm="Delete this page permanently?" style="margin-top:10px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn danger" type="submit" style="width:100%">Delete page</button>
        </form>
      </div>

      <div class="card">
        <div class="card-head"><h2>Revisions</h2></div>
        <% if (!revisions.length) { %><p class="muted small">Saving this page will start collecting revisions.</p><% } %>
        <ul class="list-reset" style="display:grid;gap:10px">
          <% revisions.forEach(function (revision) { %>
          <li class="small">
            <div><%= revision.note || 'Snapshot' %> · <%= formatDate(revision.created_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></div>
            <div class="muted"><%= revision.author || 'system' %></div>
            <form method="post" action="/admin/pages/<%= page.id %>/revisions/<%= revision.id %>/restore" data-confirm="Restore this revision? Current content is saved as a revision first.">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn secondary small" type="submit">Restore</button>
            </form>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <div class="card">
        <div class="card-head"><h2>SEO checks</h2></div>
        <ul class="list-reset small" style="display:grid;gap:6px">
          <li><%= (v.seo_title || '').length ? ((String(v.seo_title).length <= 60) ? '✓' : '!') : '•' %> Title length: <%= (v.seo_title || '').length %>/60</li>
          <li><%= (v.seo_description || '').length >= 80 ? ((String(v.seo_description).length <= 160) ? '✓' : '!') : '•' %> Description: <%= (v.seo_description || '').length %>/160</li>
          <li><%= v.noindex ? '•' : '✓' %> Indexable</li>
        </ul>
      </div>
    </aside>
  </div>
</form>

<datalist id="media-options">
  <% mediaFiles.forEach(function (file) { %><option value="/uploads/<%= file.filename %>"></option><% }); %>
</datalist>
<%- include('../partials/foot') %>
