<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title><%= title %> · Woodex OS</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="stylesheet" href="/admin-assets/admin.css">
<script src="/admin-assets/blocks-editor.js" defer></script>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <a class="sidebar-brand" href="/admin">
      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m3 6 8 28 9-20 9 20 8-28M11 6l9 28L29 6"/></svg>
      <span><strong>WOODEX</strong><span>OS v2.1</span></span>
    </a>

    <div>
      <div class="sidebar-group-title">Website</div>
      <nav aria-label="Website">
        <a href="/admin"<%- active === 'dashboard' ? ' class="active" aria-current="page"' : '' %>>Dashboard</a>
        <a href="/admin/pages"<%- active === 'pages' ? ' class="active" aria-current="page"' : '' %>>Pages</a>
        <a href="/admin/navigation"<%- active === 'navigation' ? ' class="active" aria-current="page"' : '' %>>Navigation</a>
        <a href="/admin/media"<%- active === 'media' ? ' class="active" aria-current="page"' : '' %>>Media library</a>
        <% if (can('settings:write')) { %><a href="/admin/settings"<%- active === 'settings' ? ' class="active" aria-current="page"' : '' %>>Settings</a><% } %>
      </nav>
    </div>

    <div>
      <div class="sidebar-group-title">Content</div>
      <nav aria-label="Content">
        <a href="/admin/projects"<%- active === 'projects' ? ' class="active" aria-current="page"' : '' %>>Projects</a>
        <a href="/admin/insights"<%- active === 'insights' ? ' class="active" aria-current="page"' : '' %>>Insights</a>
        <a href="/admin/services"<%- active === 'services' ? ' class="active" aria-current="page"' : '' %>>Services</a>
        <a href="/admin/enquiries"<%- active === 'enquiries' ? ' class="active" aria-current="page"' : '' %>>Enquiries<% if (newEnquiries > 0) { %><span class="count"><%= newEnquiries %></span><% } %></a>
      </nav>
    </div>

    <div>
      <div class="sidebar-group-title">System</div>
      <nav aria-label="System">
        <% if (can('users:manage')) { %><a href="/admin/users"<%- active === 'users' ? ' class="active" aria-current="page"' : '' %>>Users</a><% } %>
        <% if (can('tokens:manage')) { %><a href="/admin/tokens"<%- active === 'tokens' ? ' class="active" aria-current="page"' : '' %>>API tokens</a><% } %>
        <% if (can('audit:read')) { %><a href="/admin/activity"<%- active === 'activity' ? ' class="active" aria-current="page"' : '' %>>Activity log</a><% } %>
        <a href="/admin/health"<%- active === 'health' ? ' class="active" aria-current="page"' : '' %>>Health &amp; QA</a>
      </nav>
    </div>

    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">View live site ↗</a>
      <span>Signed in as <%= user.email %></span>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary small" type="submit">Sign out</button></form>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <h1><%= title %></h1>
      <div class="topbar-actions">
        <span class="user-chip"><span class="avatar"><%= (user.name || user.email).slice(0, 1).toUpperCase() %></span><%= user.name %> <span class="role-badge"><%= roleLabels[user.role] %></span></span>
      </div>
    </header>
    <div class="content">
      <% if (flash.ok) { %><div class="alert ok" role="status"><%= flash.ok %></div><% } %>
      <% if (flash.err) { %><div class="alert err" role="alert"><%= flash.err %></div><% } %>
      <% if (typeof errors !== 'undefined' && errors && Object.keys(errors).length) { %>
      <div class="alert err" role="alert"><strong>Please check the highlighted fields.</strong>
        <ul class="small" style="margin:6px 0 0 16px"><% Object.entries(errors).forEach(function (entry) { %><li><%= entry[1] %></li><% }); %></ul>
      </div>
      <% } %>
