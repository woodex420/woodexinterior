<section class="section soft">
  <div class="container">
    <div class="section-heading">
      <div>
        <% if (block.eyebrow) { %><div class="eyebrow"><%= block.eyebrow %></div><% } %>
        <% if (block.title) { %><h2><%- block.title %></h2><% } %>
      </div>
      <% if (block.ctaLabel) { %><a class="btn outline" href="<%= block.ctaHref || '/services' %>"><%= block.ctaLabel %><span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><% } %>
    </div>
    <div class="services-grid">
      <% block.items.forEach(function (item) { %>
      <article class="service-card">
        <div class="service-card-top">
          <svg viewBox="0 0 70 70" aria-hidden="true"><path d="m8 31 27-23 27 23M14 27v35h42V27M28 62V39h14v23M8 62h54M20 30h8m14 0h8"/></svg>
          <span><%= item.number %></span>
        </div>
        <h3><%= item.title %></h3>
        <p><%= item.summary %></p>
        <a class="text-link" href="<%= item.href || '/services' %>">Discover more<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a>
      </article>
      <% }); %>
    </div>
  </div>
</section>
