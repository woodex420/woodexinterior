<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <% if (block.eyebrow) { %><div class="eyebrow"><%= block.eyebrow %></div><% } %>
        <% if (block.title) { %><h2><%- block.title %></h2><% } %>
      </div>
      <% if (block.ctaLabel) { %><a class="btn outline" href="<%= block.ctaHref || '/insights' %>"><%= block.ctaLabel %><span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><% } %>
    </div>
    <div class="journal-grid">
      <% insights.slice(0, 3).forEach(function (post) { %>
      <article class="journal-card">
        <a href="/insights/<%= post.slug %>">
          <div class="image-wrap"><img src="<%= asset(post.cover_image || '/assets/detail.jpg') %>" alt="<%= post.title %>" loading="lazy" decoding="async" width="800" height="500"></div>
          <div class="journal-meta"><span><%= post.category %></span><span><%= post.reading_time %></span></div>
          <h3><%= post.title %></h3>
        </a>
        <a class="text-link" href="/insights/<%= post.slug %>">Read the story<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a>
      </article>
      <% }); %>
    </div>
  </div>
</section>
