# Woodex OS v2.1
PORT=4321
HOST=0.0.0.0
NODE_ENV=development

# Public URL used for canonical links and sitemap.xml
WOODEX_BASE_URL=https://woodex.com.pk

# SQLite database file (defaults to data/woodex-os.sqlite)
WOODEX_DB=

# Shared design system assets and uploaded media
WOODEX_ASSETS_DIR=../woodex/assets
WOODEX_UPLOAD_DIR=

# Set to 1 behind HTTPS (required for Secure cookies)
WOODEX_SECURE_COOKIES=0

# First-run owner account (npm run seed)
WOODEX_ADMIN_EMAIL=admin@woodexinterior.pk
WOODEX_ADMIN_PASSWORD=

# Abuse protection
# Maximum failed logins per window, per IP
WOODEX_LOGIN_MAX=8
# Maximum enquiries per window, per IP
WOODEX_ENQUIRY_MAX=5
# Window length in milliseconds (default 10 minutes)
WOODEX_RATE_WINDOW_MS=600000

# Upload limit in bytes (default 5 MB)
WOODEX_MAX_UPLOAD=5242880

# Set to 0 when the app is not behind a reverse proxy
WOODEX_TRUST_PROXY=1
