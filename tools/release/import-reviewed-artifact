class Rejected(ValueError):
    """Messages are fixed source constants, never rejected values/paths/content."""


def require(ok, message):
    if not ok:
        raise Rejected(message)


def import_candidate(archive, root, digest=DIGEST, source=SOURCE, run_id=RUN_ID, expected_hashes=None):
    """Pure candidate contract seam: tests supply synthetic archives/digests explicitly."""
    archive, root = Path(archive), Path(root)
    require(archive.is_file() and not archive.is_symlink(), 'regular archive required')
    require(archive.stat().st_size <= 2_000_000, 'archive too large')
    require(hashlib.sha256(archive.read_bytes()).hexdigest() == digest, 'reviewed archive digest mismatch')
    require(root.is_dir() and not root.is_symlink(), 'regular source directory required')
    require((root / 'platform').is_dir() and not (root / 'platform').is_symlink(), 'regular platform directory required')
    for directory in [root, root / 'platform']:
        for env in directory.glob('.env*'):
            require(env.name == '.env.example', 'original runtime env present')
    for name in ['composer.json', 'platform/composer.json']:
        p = root / name
        require(p.is_file() and not p.is_symlink(), 'regular source manifest required')
    for name in ['composer.lock', 'platform/composer.lock']:
        p = root / name
        require(not p.exists() and not p.is_symlink(), 'refuse to overwrite a lock')
    with zipfile.ZipFile(archive) as z:
        entries = z.infolist()
        require(len(entries) <= 128, 'too many archive entries')
        require(sum(i.file_size for i in entries) <= 16_000_000, 'archive expansion too large')
        names = set()
        for i in entries:
            p = PurePosixPath(i.filename)
            require(i.filename not in names, 'duplicate archive entry')
            names.add(i.filename)
            require(not p.is_absolute() and '..' not in p.parts and '\\' not in i.filename and ':' not in i.filename, 'unsafe archive path')
            require(stat.S_IFMT(i.external_attr >> 16) in (0, stat.S_IFREG, stat.S_IFDIR), 'special archive entry refused')
            require(i.file_size <= 4_000_000, 'archive entry too large')
        def read(name):
            require(name in names, 'required candidate evidence absent')
            return z.read(name)  # CRC checked by zipfile; no extractall/path traversal.
        proof = json.loads(read('evidence/run.json'))
        native = json.loads(read('evidence/native-runtime.json'))
        alignment = json.loads(read('evidence/lock-alignment.json'))
        require(proof.get('sourceSha') == source and str(proof.get('runId')) == run_id, 'candidate provenance mismatch')
        require(proof.get('mode') == 'resolve-lock-candidates' and proof.get('readyForProductionDeployment') is False, 'candidate scope mismatch')
        require(native.get('status') == 'NATIVE_PREREQUISITES_ONLY' and native.get('native_elf_binary') is True and native.get('missing_extensions') == [], 'native prerequisite proof absent')
        require(re.match(r'^8\.5\.', str(native.get('php', ''))) is not None, 'native PHP8.5 proof absent')
        require(alignment.get('status') == 'METADATA_ONLY' and alignment.get('errors') == [], 'candidate alignment failed')
        files = {}
        for local, original, paired in [
            ('composer.json', 'locks/root/composer.json', 'locks/paired/composer.json'),
            ('composer.lock', 'locks/root/composer.lock', 'locks/paired/composer.lock'),
            ('platform/composer.json', 'locks/platform/composer.json', 'locks/paired/platform/composer.json'),
            ('platform/composer.lock', 'locks/platform/composer.lock', 'locks/paired/platform/composer.lock'),
        ]:
            data = read(original)
            require(data == read(paired), 'paired candidate bytes differ')
            if local.endswith('.json'):
                require(data == (root / local).read_bytes(), 'candidate manifest differs from source')
            files[local] = data
        if expected_hashes is not None:
            require({n: hashlib.sha256(b).hexdigest() for n, b in files.items()} == expected_hashes,
                    'diagnostic dependency bytes differ from original reviewed candidate')
        # The archive hash binds the actual solver outputs; metadata is not used to fabricate a lock.
        for name in ['composer.lock', 'platform/composer.lock']:
            lock = json.loads(files[name])
            require(isinstance(lock.get('packages'), list) and len(lock['packages']) > 0, 'invalid candidate lock')
        # Do not overwrite/stage/commit/adopt any lock in the repository: CI checkout only.
        created = []
        try:
            for name in ['composer.lock', 'platform/composer.lock']:
                with (root / name).open('xb') as f:
                    f.write(files[name])
                created.append(root / name)
        except Exception:
            for p in created:
                p.unlink()
            raise
    return {'scope': 'Reviewed-artifact candidate validation ONLY; not committed-lock/release/backup acceptance',
            'candidateValidationOnly': True, 'readyForProductionDeployment': False,
            'sourceSha': source, 'resolverRunId': run_id, 'archiveSha256': digest,
            'fileSha256': {n: hashlib.sha256(b).hexdigest() for n, b in files.items()}}



def validate_application_revision(root, head, source=SOURCE, reviewed_fixes=REVIEWED_APP_FIXES):
    """Accept baseline source or exactly the reviewed, byte-pinned fix set; no other app drift."""
    paths = subprocess.check_output(['git', 'diff', '--name-only', source, head, '--',
                                     'platform', 'composer.json', '.htaccess'], cwd=root, text=True).splitlines()
    if not paths:
        return {}
    require(set(paths) == set(reviewed_fixes), 'unreviewed application revision')
    for name, digest in reviewed_fixes.items():
        data = subprocess.check_output(['git', 'show', head + ':' + name], cwd=root)
        require(hashlib.sha256(data).hexdigest() == digest, 'reviewed application fix bytes mismatch')
    return reviewed_fixes


def main():
    diagnostic = len(sys.argv) == 3 and sys.argv[1] == '--diagnostic-equivalent'
    require(len(sys.argv) == 2 or diagnostic, 'exact archive argument required')
    require(os.getenv('GITHUB_ACTIONS') == 'true' and os.getenv('GITHUB_REPOSITORY') == 'woodex420/woodexinterior', 'authorized CI repository required')
    require(os.getenv('GITHUB_REF') == BRANCH and os.getenv('RUNNER_ENVIRONMENT') == 'github-hosted', 'fixed branch and hosted runner required')
    root = Path(__file__).resolve().parents[2]
    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()
    require(head == os.getenv('GITHUB_SHA'), 'checkout/run SHA mismatch')
    reviewed_fixes = validate_application_revision(root, head)
    result = import_candidate(sys.argv[2] if diagnostic else sys.argv[1], root,
                              digest=DIAGNOSTIC_DIGEST if diagnostic else DIGEST,
                              expected_hashes=REVIEWED_FILES if diagnostic else None)
    if diagnostic:
        result['scope'] = 'DIAGNOSTIC ONLY; byte-identical reviewed dependencies in a separately verified archive'
        result['originalReviewedArchiveSha256'] = DIGEST
    result['validatedAppSourceSha'] = head
    result['reviewedAppFixSha256'] = reviewed_fixes
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
