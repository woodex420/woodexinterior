#!/usr/bin/env python3
"""Synthetic archive boundary tests ONLY. Not native dependency/application acceptance."""
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import stat
import tempfile
import unittest
import zipfile

loader = importlib.machinery.SourceFileLoader('reviewed_import', str(Path(__file__).with_name('import-reviewed-artifact')))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


class Contracts(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix='woodex-synthetic-artifact-')
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name) / 'source'
        (self.root / 'platform').mkdir(parents=True)
        self.manifest = b'{"require":{"php":"^8.4.1"}}\n'
        for n in ['composer.json', 'platform/composer.json']:
            (self.root / n).write_bytes(self.manifest)
        lock = b'{"packages":[{"name":"fixture/not-real","version":"1.0"}]}'
        self.data = {
            'evidence/run.json': json.dumps({'sourceSha':'synthetic','runId':'fixture','mode':'resolve-lock-candidates','readyForProductionDeployment':False}).encode(),
            'evidence/native-runtime.json': json.dumps({'status':'NATIVE_PREREQUISITES_ONLY','native_elf_binary':True,'missing_extensions':[],'php':'8.5.12'}).encode(),
            'evidence/lock-alignment.json': b'{"status":"METADATA_ONLY","errors":[]}',
        }
        for orig, paired in [('locks/root/', 'locks/paired/'), ('locks/platform/', 'locks/paired/platform/')]:
            self.data[orig+'composer.json'] = self.data[paired+'composer.json'] = self.manifest
            self.data[orig+'composer.lock'] = self.data[paired+'composer.lock'] = lock

    def archive(self, extra=None):
        p = Path(self.tmp.name) / 'fixture.zip'
        with zipfile.ZipFile(p, 'w', compression=zipfile.ZIP_DEFLATED) as z:
            for n, b in self.data.items():
                z.writestr(n, b)
            if extra:
                z.writestr(*extra)
        return p, hashlib.sha256(p.read_bytes()).hexdigest()

    def run_import(self, **changes):
        p, digest = self.archive()
        return module.import_candidate(p, self.root, digest=changes.get('digest', digest), source=changes.get('source', 'synthetic'), run_id=changes.get('run_id', 'fixture'))

    def reject(self, **changes):
        with self.assertRaises(ValueError): self.run_import(**changes)
        self.assertFalse((self.root/'composer.lock').exists())
        self.assertFalse((self.root/'platform/composer.lock').exists())

    def test_synthetic_success_never_claims_release_and_only_writes_two_locks(self):
        r = self.run_import()
        self.assertFalse(r['readyForProductionDeployment'])
        self.assertTrue(r['candidateValidationOnly'])
        self.assertEqual(set(r['fileSha256']), {'composer.json','composer.lock','platform/composer.json','platform/composer.lock'})
        self.assertEqual((self.root/'composer.json').read_bytes(), self.manifest)

    def test_equivalent_archive_requires_exact_all_four_original_hashes(self):
        p, digest = self.archive()
        expected = {local: hashlib.sha256(self.manifest if local.endswith('.json') else self.data['locks/root/composer.lock']).hexdigest()
                    for local in ['composer.json', 'composer.lock', 'platform/composer.json', 'platform/composer.lock']}
        r = module.import_candidate(p, self.root, digest=digest, source='synthetic', run_id='fixture', expected_hashes=expected)
        self.assertEqual(r['fileSha256'], expected)
        self.assertFalse(r['readyForProductionDeployment'])

    def test_changed_equivalent_dependency_rejected_before_writing_either_lock(self):
        p, digest = self.archive()
        with self.assertRaises(module.Rejected):
            module.import_candidate(p, self.root, digest=digest, source='synthetic', run_id='fixture', expected_hashes={'composer.lock': '0'*64})
        self.assertFalse((self.root/'composer.lock').exists())
        self.assertFalse((self.root/'platform/composer.lock').exists())

    def test_wrong_digest(self): self.reject(digest='0'*64)
    def test_wrong_source(self): self.reject(source='other')
    def test_wrong_run(self): self.reject(run_id='other')
    def test_original_env_blocks_import(self):
        (self.root/'platform/.env').write_text('DO_NOT_READ_SYNTHETIC')
        self.reject()
    def test_existing_lock_not_overwritten(self):
        (self.root/'composer.lock').write_text('DO_NOT_OVERWRITE_SYNTHETIC')
        with self.assertRaises(ValueError): self.run_import()
        self.assertEqual((self.root/'composer.lock').read_text(), 'DO_NOT_OVERWRITE_SYNTHETIC')
        self.assertFalse((self.root/'platform/composer.lock').exists())
    def test_manifest_differs(self):
        (self.root/'platform/composer.json').write_text('{}')
        self.reject()
    def test_paired_bytes_differ(self):
        self.data['locks/paired/platform/composer.lock'] = b'{}'
        self.reject()
    def test_missing_proof(self):
        del self.data['evidence/run.json']; self.reject()
    def test_alignment_hold(self):
        self.data['evidence/lock-alignment.json'] = b'{"status":"HOLD","errors":["fixture"]}'
        self.reject()
    def test_native_wasm_rejected(self):
        d=json.loads(self.data['evidence/native-runtime.json']);d['native_elf_binary']=False
        self.data['evidence/native-runtime.json']=json.dumps(d).encode();self.reject()
    def test_unexpected_ready_flag_rejected(self):
        d=json.loads(self.data['evidence/run.json']);d['readyForProductionDeployment']=True
        self.data['evidence/run.json']=json.dumps(d).encode();self.reject()
    def test_traversal_rejected(self):
        p,digest=self.archive(('../outside','synthetic'))
        with self.assertRaises(ValueError):module.import_candidate(p,self.root,digest,'synthetic','fixture')
        self.assertFalse((self.root/'composer.lock').exists())
    def test_special_link_rejected(self):
        info=zipfile.ZipInfo('evidence/link');info.external_attr=(stat.S_IFLNK|0o777)<<16
        p,digest=self.archive((info,'/outside'))
        with self.assertRaises(ValueError):module.import_candidate(p,self.root,digest,'synthetic','fixture')
        self.assertFalse((self.root/'composer.lock').exists())
    def test_platform_symlink_rejected(self):
        for p in (self.root/'platform').iterdir():p.unlink()
        (self.root/'platform').rmdir();outside=Path(self.tmp.name)/'outside';outside.mkdir()
        (self.root/'platform').symlink_to(outside,target_is_directory=True)
        self.reject()


if __name__ == '__main__':
    unittest.main(verbosity=2)
