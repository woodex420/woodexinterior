# ---------------------------------------------------------------------------
# Woodex OS environment. Copy to .env. NEVER commit .env (the repo is public).
# Production values: docs/06-DEPLOYMENT-HOSTINGER.md section 4.
# ---------------------------------------------------------------------------
APP_NAME="Woodex OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Admin location. Local: http://localhost:8000/admin
# Production: ADMIN_DOMAIN=admin.woodex.com.pk and ADMIN_PATH= (empty)
ADMIN_DOMAIN=
ADMIN_PATH=admin
PUBLIC_SITE_URL=https://woodex.com.pk

# Require TOTP 2FA for owner/admin/accountant (always true in production)
ENFORCE_2FA=false

# X-Frame-Options header (keep SAMEORIGIN in production)
SECURITY_FRAME_OPTIONS=SAMEORIGIN

# First owner account for `php artisan woodex:install --no-interaction`
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=woodex_os
# DB_USERNAME=root
# DB_PASSWORD=
DB_TIMEZONE=+05:00

# Old v2.1 database (read-only user) for the importer
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@woodex.com.pk"
MAIL_FROM_NAME="Woodex Interior"

# Public lead API (website forms, live-site bridge)
PUBLIC_LEADS_ALLOWED_ORIGINS=https://woodex.com.pk,https://www.woodex.com.pk
PUBLIC_LEADS_BRIDGE_KEY=

# Cloudflare Turnstile (spam protection). Leave empty to disable in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram bot (alerts + commands). Create with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
